REACT_APP_ENVIRONMENT=local

REACT_APP_API_URL_LOCAL=http://localhost:8080
REACT_APP_API_URL_PROD=https://api.sabri.example.com
# Optional explicit override (leave empty to use per-environment values)
REACT_APP_API_URL=

# API passwords (replace with real values in your local .env.local or CI secrets)
REACT_APP_API_PASSWORD_LOCAL=
REACT_APP_API_PASSWORD_PROD=
# Optional global override
REACT_APP_API_PASSWORD=